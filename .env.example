# ---------------------------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Nothing here is required to run `npm run dev` —
# the site degrades gracefully when a value is missing.
# ---------------------------------------------------------------------------------------------

# Canonical origin. Used for sitemap URLs, Open Graph images and structured data.
NEXT_PUBLIC_SITE_URL=https://lifeandmindart.com

# --- Contact form (Resend) -------------------------------------------------------------------
# Create a key at https://resend.com and verify the lifeandmindart.com domain.
RESEND_API_KEY=
# Must be an address on a verified domain, e.g. website@lifeandmindart.com
CONTACT_FROM_EMAIL=
# Where messages land. Defaults to psy.office8@gmail.com (see src/content/site.ts).
CONTACT_TO_EMAIL=psy.office8@gmail.com

# --- Analytics (optional) --------------------------------------------------------------------
# Google Analytics 4 measurement ID. Loaded ONLY after explicit cookie consent.
NEXT_PUBLIC_GA_ID=
